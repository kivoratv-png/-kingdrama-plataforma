# ============================================================================
# Chaves usadas pelos scripts de catálogo (scripts/*.js).
#
# COPIE este arquivo para ".env" na mesma pasta e preencha os valores.
# O .gitignore já ignora o .env, então ele não vai para o GitHub.
#
#   copy .env.exemplo .env        (Windows)
#   cp   .env.exemplo .env        (Git Bash)
#
# Nada aqui é lido pelo site: o navegador só conhece as chaves públicas de
# public/js/config.js. Estas são as chaves de servidor, para carregar catálogo.
# ============================================================================

# ---------------------------------------------------------------- Supabase
# Painel do Supabase > Settings > API.
SUPABASE_URL=https://yvwdhuphzyjfhfsqdeho.supabase.co

# A chave "service_role" (NÃO a "anon"). Ela ignora o RLS e pode tudo no banco,
# por isso vive só aqui e nunca no código do site.
# Usada por: importar-catalogo.js, sincronizar-bunny.js, subir-capas.js
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Bunny
# Painel da Bunny > Stream > a biblioteca > API > Video Library API Key.
# Se você já tem o arquivo "DORAMAS PLUS/.bunny.env", os scripts leem de lá
# sozinhos e estas duas linhas são dispensáveis.
# Usada por: sincronizar-bunny.js
BUNNY_STREAM_KEY=
BUNNY_LIBRARY_ID=803532
