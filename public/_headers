# Cabeçalhos de segurança e de cache.
#
# connect-src e media-src já liberam https: porque é por aí que vão entrar
# o Supabase (dados) e a Bunny Stream (vídeo). Se quiser travar mais, troque
# https: pelos domínios exatos, por exemplo:
#   connect-src 'self' https://SEU-PROJETO.supabase.co
#   media-src   'self' blob: https://vz-XXXX.b-cdn.net
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https://yvwdhuphzyjfhfsqdeho.supabase.co; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src 'self' https://yvwdhuphzyjfhfsqdeho.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Cache: os arquivos abaixo NÃO têm hash no nome (app.js é sempre app.js), então
# cache longo faria o visitante continuar vendo a versão antiga depois de publicar.
# Com must-revalidate o navegador pergunta "mudou?" a cada visita e recebe 304
# quando não mudou — barato, e a atualização chega na hora.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/config/*
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Imagens: trocam pouco, mas ainda revalidam em 1 hora.
/banners/*
  Cache-Control: public, max-age=3600, must-revalidate

/img/*
  Cache-Control: public, max-age=86400, must-revalidate

# Biblioteca de terceiros, trocada só ao atualizar a versão.
/vendor/*
  Cache-Control: public, max-age=604800
