# Cabeçalhos de segurança e de cache.
#
# connect-src e media-src já liberam https: porque é por aí que vão entrar
# o Supabase (dados) e a Bunny Stream (vídeo). Se quiser travar mais, troque
# https: pelos domínios exatos, por exemplo:
#   connect-src 'self' https://SEU-PROJETO.supabase.co
#   media-src   'self' blob: https://vz-XXXX.b-cdn.net
/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https://yvwdhuphzyjfhfsqdeho.supabase.co; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src 'self' https://yvwdhuphzyjfhfsqdeho.supabase.co; frame-src https://player.mediadelivery.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Todas as rotas da SPA e os arquivos são buscados na rede a cada carregamento.
# A sessão de login usa armazenamento separado e não é apagada.

/admin
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
